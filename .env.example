# Database configuration
# For Docker: use service name 'postgres' as host
# For local: use 'localhost'
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/simplerag
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=simplerag

# Storage directories
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
SCAN_DIR=./documents_to_scan

# Embedding configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LLM configuration
# For Docker: use service name 'ollama' as host
# For local: use 'localhost'
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama2

# Security (change in production!)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
